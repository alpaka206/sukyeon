# Sanity 공개 콘텐츠 읽기
# 프로젝트 ID를 비워 두면 Sanity 읽기는 의도적으로 비활성화됩니다.
# 이때 빈 목록/기본 카탈로그/null 페이지를 반환하며 로컬 JSON 폴백은 사용하지 않습니다.
# 프로젝트 ID를 설정한 상태의 Sanity 요청 실패는 빌드와 호출자에 오류로 전달됩니다.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# 서버 전용 관리자 설정
# 실제 값은 배포 환경 또는 커밋되지 않는 .env.local에만 저장하세요.
# 사용자명, 비밀번호 또는 세션 시크릿을 교체하면 기존 관리자 세션이 무효화됩니다.
SANITY_API_WRITE_TOKEN=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 견적·문의 메일 발송 (Resend)
# RESEND_API_KEY: resend.com → API Keys 에서 발급한 키 (re_로 시작)
# CONTACT_MAIL_FROM: Resend에서 DNS 인증을 마친 도메인의 주소만 사용할 수 있습니다.
#   예) 석연MRO 견적문의 <no-reply@인증한도메인>
# CONTACT_MAIL_TO: 문의를 받을 주소. 비워 두면 sukyeonmro@naver.com으로 발송됩니다.
RESEND_API_KEY=
CONTACT_MAIL_FROM=
CONTACT_MAIL_TO=sukyeonmro@naver.com

# 선택 사항: 로컬 개발에서 React 진단 도구를 비활성화합니다.
# 운영 번들에는 진단 도구가 포함되지 않아야 합니다.
NEXT_PUBLIC_DISABLE_REACT_DEVTOOLS=
