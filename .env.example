# ── Sanity 연동 (sanity.io/manage 에서 프로젝트 생성 후 입력) ──────────────
# 공개(public) dataset이면 읽기 토큰 없이 동작합니다. 값이 비어 있으면
# 사이트는 src/content/*.json(로컬 폴백)으로 동작합니다.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# 관리자 로그인과 콘텐츠 저장에 모두 필요합니다. 서버에만 설정하고 브라우저에 노출하지 마세요.
SANITY_API_WRITE_TOKEN=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 충분히 긴 무작위 문자열을 사용하세요. 변경하면 기존 관리자 세션과 로그인 제한 기록이 초기화됩니다.
ADMIN_SESSION_SECRET=
